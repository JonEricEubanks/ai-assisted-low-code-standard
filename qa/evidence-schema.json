{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/qa/evidence-schema.json",
  "title": "QA evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceId",
    "runId",
    "project",
    "environment",
    "solutionVersion",
    "requirementId",
    "testId",
    "executor",
    "timestamp",
    "result",
    "expected",
    "actual",
    "artifacts",
    "reviewer",
    "classification",
    "retentionTag"
  ],
  "properties": {
    "evidenceId": {
      "type": "string",
      "pattern": "^EVD-[A-Z0-9]+-[0-9]{3}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-[A-Z0-9]+-[0-9]{3}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "solutionVersion": {
      "type": "string",
      "minLength": 1
    },
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-([A-Z0-9]+-)?[0-9]{3}$"
    },
    "testId": {
      "type": "string",
      "pattern": "^TST-[A-Z0-9]+-[0-9]{3}$"
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "modelSkillVersion": {
      "type": "string",
      "minLength": 1
    },
    "persona": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "review-needed"
      ]
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "actual": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "reference",
          "claim"
        ],
        "properties": {
          "type": {
            "enum": [
              "log",
              "screenshot",
              "video",
              "trace",
              "export"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "defectId": {
      "type": "string",
      "pattern": "^DEF-[A-Z0-9]+-[0-9]{3}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approver",
        "decision"
      ],
      "properties": {
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "deferred"
          ]
        }
      }
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "retentionTag": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "fail"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "defectId"
        ]
      }
    }
  ]
}
